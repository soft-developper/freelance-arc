{
  "name": "freelance-arc",
  "version": "1.0.0",
  "description": "Freelancer payment platform on Arc — USDC escrow + auto invoices",
  "scripts": {
    "compile": "npx hardhat compile",
    "test": "npx hardhat test",
    "deploy": "npx hardhat run scripts/deploy.js --network arc-testnet",
    "deploy:local": "npx hardhat run scripts/deploy.js --network hardhat",
